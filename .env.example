# =============================================================
# Backend selection — switch between local and ngrok without code changes
# =============================================================
# Which backend is active. Allowed values: "local" | "ngrok"
EXPO_PUBLIC_ACTIVE_BACKEND=ngrok

# Local backend (Docker / dotnet run on this machine)
EXPO_PUBLIC_LOCAL_API_URL=http://localhost:5000

# Ngrok tunnel (URL changes every time you restart ngrok)
EXPO_PUBLIC_NGROK_API_URL=https://interiorly-pinnatisect-adalyn.ngrok-free.dev

# =============================================================
# Notes
# =============================================================
# - `EXPO_PUBLIC_ACTIVE_BACKEND` picks which of the two URLs above is used.
# - To switch backends, change `EXPO_PUBLIC_ACTIVE_BACKEND` and restart `npx expo start --clear`.
# - When pointing at ngrok, make sure your BE CORS settings allow the ngrok domain.
#
# Legacy: `EXPO_PUBLIC_API_BASE_URL` is still respected if set explicitly; when present
# it overrides both the local and ngrok selection above.

# Floor id to load on the bản đồ screen. Must match a `Floors.FloorId` row
# in the BE database. Defaults to 1 when unset.
EXPO_PUBLIC_DEFAULT_FLOOR_ID=1
