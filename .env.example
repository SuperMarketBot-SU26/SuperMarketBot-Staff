# SmartMarketBot Staff — environment template.
# Copy to .env, fill in real values, and run `expo start --clear`.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle at build time
# (Expo SDK 50+), so values here are visible to the app — do NOT put
# secrets here. The staff app does not hold secrets; only the API base URL.

# Base URL of the SmartMarketBot backend (no trailing slash).
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000

# Floor id to load on the bản đồ screen. Must match a `Floors.FloorId` row
# in the BE database. Defaults to 1 when unset.
EXPO_PUBLIC_DEFAULT_FLOOR_ID=1
